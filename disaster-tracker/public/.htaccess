<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Set the base path
    RewriteBase /tugas/disaster-tracker/public/
    
    # Remove index.php from the URL
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

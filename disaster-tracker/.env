APP_NAME="Disaster Tracker"
APP_ENV=local
APP_KEY=base64:fakekey123456789012345678901234567890123456=
APP_DEBUG=true
APP_URL=http://localhost/tugas/disaster-tracker/public

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tugas
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

USGS_API=https://earthquake.usgs.gov/fdsnws/event/1/query
EMSC_API=https://www.seismicportal.eu/fdsnws/event/1/query
IRIS_API=https://service.iris.edu/fdsnws/event/1/query
USGS_VOLCANO_API=https://volcano.si.edu/webservices/geoserver/GVP-USGS/ows
NOAA_STORM_API=https://www.nhc.noaa.gov/gis/forecast/archive
PTWC_TSUNAMI_API=https://www.tsunami.gov/

DEDUP_RADIUS_KM=10
DEDUP_TIME_HOURS=1
POLL_INTERVAL_SECONDS=300
DATA_RETENTION_DAYS=7
